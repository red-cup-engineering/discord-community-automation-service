import { createHash, createHmac } from "node:crypto";
import { mkdir, readFile, rename, writeFile } from "node:fs/promises";
import path from "node:path";

export type ReactionKind = "add" | "remove";
export type RoleEffectKind = "add-role" | "remove-role";
export type ReceiptStatus = "reserved" | "applied" | "failed" | "recoverable" | "duplicate";
export interface DiscordReactionEvent { readonly type: "DiscordReactionEvent"; readonly version: 1; readonly eventId: string; readonly occurredAt: string; readonly kind: ReactionKind; readonly guildId: string; readonly channelId: string; readonly messageId: string; readonly actorId: string; readonly emoji: Readonly<{ name?: string; id?: string }>; }
export interface ReactionRoleBinding { readonly type: "DiscordReactionRoleBinding"; readonly version: 1; readonly id: string; readonly revision: number; readonly guildId: string; readonly channelId: string; readonly messageId: string; readonly emoji: Readonly<{ name?: string; id?: string }>; readonly onAdd: readonly RoleEffectKind[]; readonly onRemove: readonly RoleEffectKind[]; readonly roleId: string; }
export interface ReactionPolicyState { readonly type: "DiscordReactionPolicyState"; readonly version: 1; readonly observedAt: string; readonly sourceRevision: string; readonly messagePresent: boolean; readonly role: Readonly<{ exists: boolean; managed: boolean; position: number; botHighestPosition: number }>; readonly actorRoleIds: readonly string[]; }
export interface RoleEffectPlan { readonly type: "DiscordRoleEffectPlan"; readonly version: 1; readonly id: string; readonly bindingId: string; readonly bindingRevision: number; readonly eventKey: string; readonly action: RoleEffectKind; readonly guildId: string; readonly channelId: string; readonly messageId: string; readonly actorId: string; readonly emoji: Readonly<{ name?: string; id?: string }>; readonly roleId: string; readonly expected: Readonly<{ messagePresent: true; roleManaged: false; roleBelowBot: true; actorHasRole: boolean }>; }
export interface RollbackPlan { readonly type: "DiscordRoleEffectRollbackPlan"; readonly version: 1; readonly id: string; readonly sourcePlanId: string; readonly bindingId: string; readonly bindingRevision: number; readonly action: RoleEffectKind; readonly guildId: string; readonly actorId: string; readonly roleId: string; readonly expectedActorHasRole: boolean; }
export type ManagedEffectPlan = RoleEffectPlan | RollbackPlan;
export type PolicyDecision = Readonly<{ kind: "ignore"; reason: string }> | Readonly<{ kind: "observe" | "refuse"; reason: string; bindingId: string }> | Readonly<{ kind: "propose"; bindingId: string; plans: readonly RoleEffectPlan[] }>;
export interface EffectReceipt { readonly type: "DiscordCommunityEffectReceipt"; readonly version: 2; readonly plan: ManagedEffectPlan; readonly status: ReceiptStatus; readonly recordedAt: string; readonly reason?: string; }
export interface PortableEffectReceiptJournal { readonly type: "DiscordCommunityEffectReceiptJournal"; readonly version: 2; readonly receipts: readonly EffectReceipt[]; }
export interface EffectReceiptJournal { reserve(plan: ManagedEffectPlan, recordedAt: string): Promise<EffectReceipt>; complete(planId: string, status: "applied" | "failed", recordedAt: string, reason?: string): Promise<EffectReceipt>; recover(recordedAt: string, reason?: string): Promise<readonly EffectReceipt[]>; get(planId: string): Promise<EffectReceipt | undefined>; export(): Promise<PortableEffectReceiptJournal>; }
export interface RoleEffectExecutor { addRole(input: Readonly<{ guildId: string; actorId: string; roleId: string }>): Promise<void>; removeRole(input: Readonly<{ guildId: string; actorId: string; roleId: string }>): Promise<void>; }
export interface DurableEffectReceiptProjection { readonly type: "DiscordCommunityEffectReceiptProjection"; readonly version: 2; readonly planId: string; readonly bindingId: string; readonly bindingRevision: number; readonly action: RoleEffectKind; readonly status: ReceiptStatus; readonly recordedAt: string; readonly actorPseudonym: string; readonly privacy: Readonly<{ retained: readonly string[]; omitted: readonly string[] }>; }

const identifier = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$/u;
const digest = (value: unknown): string => createHash("sha256").update(JSON.stringify(value)).digest("hex");
function required(value: string, label: string): string { if (!identifier.test(value)) throw new TypeError(`${label} must be a nonempty identifier`); return value; }
function instant(value: string, label: string): string { if (!Number.isFinite(Date.parse(value))) throw new TypeError(`${label} must be an ISO timestamp`); return new Date(value).toISOString(); }
function emoji(value: Readonly<{ name?: string; id?: string }>): Readonly<{ name?: string; id?: string }> { const name = value.name?.trim(), id = value.id?.trim(); if (!name && !id) throw new TypeError("emoji needs a name or id"); if (id) required(id, "emoji id"); return Object.freeze({ ...(name ? { name } : {}), ...(id ? { id } : {}) }); }
function sameEmoji(a: Readonly<{ name?: string; id?: string }>, b: Readonly<{ name?: string; id?: string }>): boolean { const left = emoji(a), right = emoji(b); return left.id !== undefined || right.id !== undefined ? left.id === right.id : left.name === right.name; }
function freezeReceipt(receipt: EffectReceipt): EffectReceipt { return Object.freeze({ ...receipt, plan: Object.freeze({ ...receipt.plan }) }); }

export function normalizeReactionEvent(input: DiscordReactionEvent): DiscordReactionEvent {
  if (input.type !== "DiscordReactionEvent" || input.version !== 1 || !["add", "remove"].includes(input.kind)) throw new TypeError("unsupported reaction event");
  return Object.freeze({ ...input, eventId: required(input.eventId, "event id"), occurredAt: instant(input.occurredAt, "occurredAt"), guildId: required(input.guildId, "guild id"), channelId: required(input.channelId, "channel id"), messageId: required(input.messageId, "message id"), actorId: required(input.actorId, "actor id"), emoji: emoji(input.emoji) });
}
export function normalizeReactionRoleBinding(input: ReactionRoleBinding): ReactionRoleBinding {
  if (input.type !== "DiscordReactionRoleBinding" || input.version !== 1 || !Number.isSafeInteger(input.revision) || input.revision < 1) throw new TypeError("unsupported reaction role binding");
  const actions = (value: readonly RoleEffectKind[]): readonly RoleEffectKind[] => { if (!Array.isArray(value) || value.some((action) => action !== "add-role" && action !== "remove-role")) throw new TypeError("binding effects must be role effects"); if (new Set(value).size !== value.length) throw new TypeError("binding effects must not contain duplicates"); if (value.length > 1) throw new TypeError("binding effects must not contain contradictory role actions"); return Object.freeze([...value]); };
  return Object.freeze({ ...input, id: required(input.id, "binding id"), guildId: required(input.guildId, "guild id"), channelId: required(input.channelId, "channel id"), messageId: required(input.messageId, "message id"), roleId: required(input.roleId, "role id"), emoji: emoji(input.emoji), onAdd: actions(input.onAdd), onRemove: actions(input.onRemove) });
}
export function normalizeReactionPolicyState(input: ReactionPolicyState, now = new Date(), maxAgeMs = 60_000): ReactionPolicyState {
  if (input.type !== "DiscordReactionPolicyState" || input.version !== 1) throw new TypeError("unsupported policy state");
  const observedAt = instant(input.observedAt, "observedAt"); required(input.sourceRevision, "source revision");
  if (Date.parse(observedAt) > now.getTime() + 5_000 || now.getTime() - Date.parse(observedAt) > maxAgeMs) throw new TypeError("policy state is not fresh");
  if (!Number.isInteger(input.role.position) || !Number.isInteger(input.role.botHighestPosition)) throw new TypeError("policy state role positions must be integers");
  return Object.freeze({ ...input, observedAt, actorRoleIds: Object.freeze([...new Set(input.actorRoleIds.map((id) => required(id, "actor role id")))]) });
}
export function reactionEventKey(event: DiscordReactionEvent): string { const item = normalizeReactionEvent(event); return `discord-reaction:${digest({ guildId: item.guildId, channelId: item.channelId, messageId: item.messageId, actorId: item.actorId, kind: item.kind, emoji: item.emoji, eventId: item.eventId })}`; }
export function evaluateReactionRoleBinding(eventInput: DiscordReactionEvent, bindingInput: ReactionRoleBinding, stateInput: ReactionPolicyState, now = new Date(), maxAgeMs = 60_000): PolicyDecision {
  const event = normalizeReactionEvent(eventInput), binding = normalizeReactionRoleBinding(bindingInput);
  if (event.guildId !== binding.guildId || event.channelId !== binding.channelId || event.messageId !== binding.messageId || !sameEmoji(event.emoji, binding.emoji)) return Object.freeze({ kind: "ignore", reason: "reaction does not match binding" });
  let state: ReactionPolicyState; try { state = normalizeReactionPolicyState(stateInput, now, maxAgeMs); } catch (error) { return Object.freeze({ kind: "refuse", bindingId: binding.id, reason: error instanceof Error ? error.message : "invalid policy state" }); }
  if (!state.messagePresent) return Object.freeze({ kind: "refuse", bindingId: binding.id, reason: "bound message is absent" });
  if (!state.role.exists) return Object.freeze({ kind: "refuse", bindingId: binding.id, reason: "bound role is absent" });
  if (state.role.managed) return Object.freeze({ kind: "refuse", bindingId: binding.id, reason: "bound role is integration-managed" });
  if (state.role.position <= 0 || state.role.position >= state.role.botHighestPosition) return Object.freeze({ kind: "refuse", bindingId: binding.id, reason: "bound role is not below the executor role hierarchy" });
  const actions = event.kind === "add" ? binding.onAdd : binding.onRemove; if (actions.length === 0) return Object.freeze({ kind: "observe", bindingId: binding.id, reason: "binding intentionally has no effect for this reaction" });
  const actorHasRole = state.actorRoleIds.includes(binding.roleId), action = actions[0]!;
  if ((action === "add-role" && actorHasRole) || (action === "remove-role" && !actorHasRole)) return Object.freeze({ kind: "observe", bindingId: binding.id, reason: "role already has the requested state" });
  const eventKey = reactionEventKey(event), material = { eventKey, bindingId: binding.id, bindingRevision: binding.revision, action, guildId: event.guildId, channelId: event.channelId, messageId: event.messageId, actorId: event.actorId, emoji: event.emoji, roleId: binding.roleId };
  const plan: RoleEffectPlan = Object.freeze({ type: "DiscordRoleEffectPlan", version: 1, id: `discord-role-effect:${digest(material)}`, ...material, expected: Object.freeze({ messagePresent: true, roleManaged: false, roleBelowBot: true, actorHasRole }) });
  return Object.freeze({ kind: "propose", bindingId: binding.id, plans: Object.freeze([plan]) });
}
function satisfies(plan: ManagedEffectPlan, state: ReactionPolicyState): boolean { const actorHasRole = state.actorRoleIds.includes(plan.roleId); return state.role.exists && !state.role.managed && state.role.position > 0 && state.role.position < state.role.botHighestPosition && (plan.type === "DiscordRoleEffectRollbackPlan" ? actorHasRole === plan.expectedActorHasRole : state.messagePresent && actorHasRole === plan.expected.actorHasRole); }
function effectInput(plan: ManagedEffectPlan): Readonly<{ guildId: string; actorId: string; roleId: string }> { return { guildId: plan.guildId, actorId: plan.actorId, roleId: plan.roleId }; }

export class InMemoryEffectReceiptJournal implements EffectReceiptJournal {
  readonly #receipts = new Map<string, EffectReceipt>();
  constructor(initial?: PortableEffectReceiptJournal) { if (initial) for (const receipt of importEffectReceiptJournal(initial).receipts) this.#receipts.set(receipt.plan.id, receipt); }
  async reserve(plan: ManagedEffectPlan, recordedAt: string): Promise<EffectReceipt> { const prior = this.#receipts.get(plan.id); if (prior) return freezeReceipt({ ...prior, status: "duplicate" }); const receipt = freezeReceipt({ type: "DiscordCommunityEffectReceipt", version: 2, plan, status: "reserved", recordedAt: instant(recordedAt, "recordedAt") }); this.#receipts.set(plan.id, receipt); return receipt; }
  async complete(planId: string, status: "applied" | "failed", recordedAt: string, reason?: string): Promise<EffectReceipt> { const prior = this.#receipts.get(planId); if (!prior) throw new Error("effect plan was not reserved"); if (prior.status !== "reserved") return freezeReceipt({ ...prior, status: "duplicate" }); const receipt = freezeReceipt({ ...prior, status, recordedAt: instant(recordedAt, "recordedAt"), ...(reason ? { reason } : {}) }); this.#receipts.set(planId, receipt); return receipt; }
  async recover(recordedAt: string, reason = "interrupted before completion"): Promise<readonly EffectReceipt[]> { const at = instant(recordedAt, "recordedAt"), out: EffectReceipt[] = []; for (const [id, prior] of this.#receipts) if (prior.status === "reserved") { const receipt = freezeReceipt({ ...prior, status: "recoverable", recordedAt: at, reason }); this.#receipts.set(id, receipt); out.push(receipt); } return Object.freeze(out); }
  async get(planId: string): Promise<EffectReceipt | undefined> { return this.#receipts.get(planId); }
  async export(): Promise<PortableEffectReceiptJournal> { return Object.freeze({ type: "DiscordCommunityEffectReceiptJournal", version: 2, receipts: Object.freeze([...this.#receipts.values()]) }); }
}
export class FileEffectReceiptJournal extends InMemoryEffectReceiptJournal {
  readonly #file: string; private constructor(file: string, initial?: PortableEffectReceiptJournal) { super(initial); this.#file = file; }
  static async open(file: string): Promise<FileEffectReceiptJournal> { try { return new FileEffectReceiptJournal(file, importEffectReceiptJournal(JSON.parse(await readFile(file, "utf8")) as PortableEffectReceiptJournal)); } catch (error: unknown) { if ((error as { code?: string }).code === "ENOENT") return new FileEffectReceiptJournal(file); throw error; } }
  async #persist(): Promise<void> { await mkdir(path.dirname(this.#file), { recursive: true }); const temporary = `${this.#file}.${process.pid}.tmp`; await writeFile(temporary, `${JSON.stringify(await super.export())}\n`, { mode: 0o600 }); await rename(temporary, this.#file); }
  override async reserve(plan: ManagedEffectPlan, at: string): Promise<EffectReceipt> { const receipt = await super.reserve(plan, at); if (receipt.status !== "duplicate") await this.#persist(); return receipt; }
  override async complete(id: string, status: "applied" | "failed", at: string, reason?: string): Promise<EffectReceipt> { const receipt = await super.complete(id, status, at, reason); if (receipt.status !== "duplicate") await this.#persist(); return receipt; }
  override async recover(at: string, reason?: string): Promise<readonly EffectReceipt[]> { const receipts = await super.recover(at, reason); if (receipts.length) await this.#persist(); return receipts; }
}
export function importEffectReceiptJournal(record: PortableEffectReceiptJournal): PortableEffectReceiptJournal {
  if (record.type !== "DiscordCommunityEffectReceiptJournal" || record.version !== 2 || !Array.isArray(record.receipts)) throw new TypeError("unsupported effect receipt journal");
  const seen = new Set<string>(), statuses = new Set<ReceiptStatus>(["reserved", "applied", "failed", "recoverable", "duplicate"]);
  const receipts = record.receipts.map((receipt) => { if (receipt.type !== "DiscordCommunityEffectReceipt" || receipt.version !== 2 || !statuses.has(receipt.status) || seen.has(receipt.plan.id)) throw new TypeError("receipt journal has an invalid or duplicate receipt"); seen.add(receipt.plan.id); if (receipt.plan.type === "DiscordRoleEffectPlan") { const plan = receipt.plan; required(plan.bindingId, "binding id"); required(plan.roleId, "role id"); emoji(plan.emoji); if (plan.bindingRevision < 1 || plan.id !== `discord-role-effect:${digest({ eventKey: plan.eventKey, bindingId: plan.bindingId, bindingRevision: plan.bindingRevision, action: plan.action, guildId: plan.guildId, channelId: plan.channelId, messageId: plan.messageId, actorId: plan.actorId, emoji: plan.emoji, roleId: plan.roleId })}`) throw new TypeError("receipt plan is invalid"); } else if (receipt.plan.type !== "DiscordRoleEffectRollbackPlan" || receipt.plan.version !== 1 || receipt.plan.bindingRevision < 1 || receipt.plan.id !== `discord-role-rollback:${digest({ sourcePlanId: receipt.plan.sourcePlanId, action: receipt.plan.action, bindingRevision: receipt.plan.bindingRevision })}`) throw new TypeError("receipt plan is invalid"); return freezeReceipt({ ...receipt, recordedAt: instant(receipt.recordedAt, "recordedAt") }); });
  return Object.freeze({ type: "DiscordCommunityEffectReceiptJournal", version: 2, receipts: Object.freeze(receipts) });
}
export async function executeRoleEffect(plan: ManagedEffectPlan, journal: EffectReceiptJournal, executor: RoleEffectExecutor, readFreshState: () => Promise<ReactionPolicyState>, recordedAt: string, maxAgeMs = 60_000): Promise<EffectReceipt> {
  const reservation = await journal.reserve(plan, recordedAt); if (reservation.status === "duplicate") return reservation;
  try { const before = normalizeReactionPolicyState(await readFreshState(), new Date(recordedAt), maxAgeMs); if (!satisfies(plan, before)) return journal.complete(plan.id, "failed", recordedAt, "precondition changed before execution"); const finalState = normalizeReactionPolicyState(await readFreshState(), new Date(recordedAt), maxAgeMs); if (!satisfies(plan, finalState)) return journal.complete(plan.id, "failed", recordedAt, "precondition changed immediately before execution"); if (plan.action === "add-role") await executor.addRole(effectInput(plan)); else await executor.removeRole(effectInput(plan)); return journal.complete(plan.id, "applied", recordedAt); } catch (error: unknown) { return journal.complete(plan.id, "failed", recordedAt, error instanceof Error ? error.message : String(error)); }
}
export function rollbackPlan(receipt: EffectReceipt): RollbackPlan | undefined { if (receipt.status !== "applied" || receipt.plan.type !== "DiscordRoleEffectPlan") return undefined; const action: RoleEffectKind = receipt.plan.action === "add-role" ? "remove-role" : "add-role"; return Object.freeze({ type: "DiscordRoleEffectRollbackPlan", version: 1, id: `discord-role-rollback:${digest({ sourcePlanId: receipt.plan.id, action, bindingRevision: receipt.plan.bindingRevision })}`, sourcePlanId: receipt.plan.id, bindingId: receipt.plan.bindingId, bindingRevision: receipt.plan.bindingRevision, action, guildId: receipt.plan.guildId, actorId: receipt.plan.actorId, roleId: receipt.plan.roleId, expectedActorHasRole: receipt.plan.action === "add-role" }); }
export function projectDurableEffectReceipt(receipt: EffectReceipt, pseudonymKey: string): DurableEffectReceiptProjection { if (pseudonymKey.length < 32) throw new TypeError("pseudonym key must contain at least 32 characters"); const actorPseudonym = `urn:discord-community-automation:actor:${createHmac("sha256", pseudonymKey).update(`v2\0${receipt.plan.guildId}\0${receipt.plan.actorId}`).digest("hex")}`; return Object.freeze({ type: "DiscordCommunityEffectReceiptProjection", version: 2, planId: receipt.plan.id, bindingId: receipt.plan.bindingId, bindingRevision: receipt.plan.bindingRevision, action: receipt.plan.action, status: receipt.status, recordedAt: receipt.recordedAt, actorPseudonym, privacy: Object.freeze({ retained: Object.freeze(["planId", "bindingId", "bindingRevision", "action", "status", "recordedAt", "actorPseudonym"]), omitted: Object.freeze(["eventId", "guildId", "channelId", "messageId", "actorId", "emoji", "roleId", "messageContent"]) }) }); }
